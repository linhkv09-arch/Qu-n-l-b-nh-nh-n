{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/telegram-notify", "schedule": "0 1 * * *" },
    { "path": "/api/telegram-notify", "schedule": "0 5 * * *" },
    { "path": "/api/telegram-notify", "schedule": "0 10 * * *" }
  ]
}
